{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@client/*": ["packages/client/src/*"],
      "@server/*": ["packages/server/src/*"],
      "@shared/*": ["packages/shared/*"]
    }
  },
  "include": [
    "src/**/*",
    "packages/**/*",
    "global.d.ts",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}