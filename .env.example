# ============================================
# PhD RESEARCH PLATFORM - ПРИМЕР .env файла
# Копировать в .env и заполнить значения
# ============================================

# ОБЩИЕ
NODE_ENV=development
APP_NAME="PhD Research Platform"
PORT=5000

# БАЗА ДАННЫХ
MONGODB_URI=mongodb://localhost:27017/phd-platform
MONGO_USERNAME=admin
MONGO_PASSWORD=your-strong-password-here

# REDIS
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT ТОКЕНЫ
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ФРОНТЕНД
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_get_from_mapbox.com

# CORS
CORS_ORIGIN=http://localhost:3000

# РАЗНОЕ
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
LOG_LEVEL=debug