{
  "name": "phd-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"green,blue\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev:server": "npm run dev --workspace=packages/server",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace=packages/client",
    "build:server": "npm run build --workspace=packages/server",
    "start": "node packages/server/dist/index.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "type-check": "tsc --noEmit",
    "type-check:server": "npm run type-check --workspace=packages/server",
    "type-check:client": "npm run type-check --workspace=packages/client",
    "lint": "eslint . --ext .ts,.tsx,.vue,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue,.js --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md}\"",
    "clean": "rm -rf node_modules packages/*/node_modules dist build coverage",
    "install:all": "npm install && cd packages/client && npm install && cd ../server && npm install",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.0.0"
}