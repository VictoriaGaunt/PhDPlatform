# ============ ОПЕРАЦИОННЫЕ СИСТЕМЫ =========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============ ИДЕ и РЕДАКТОРЫ =============
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ============ NODE.JS =====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# ============ КОМПИЛИРОВАННЫЕ ФАЙЛЫ =======
dist/
build/
out/
*.tsbuildinfo

# ============ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ========
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.example
!.env.example

# ============ DOCKER ======================
docker-compose.override.yml
.dockerignore

# ============ БАЗЫ ДАННЫХ =================
*.db
*.sqlite
*.sqlite3
mongodata/
redisdata/

# ============ ЗАГРУЖАЕМЫЕ ФАЙЛЫ ==========
uploads/*
!uploads/.gitkeep
temp/
tmp/

# ============ ЛОГИ =======================
*.log
logs/*
!logs/.gitkeep

# ============ ТЕСТЫ ======================
coverage/
.nyc_output
*.lcov

# ============ ДОКУМЕНТАЦИЯ ===============
docs/_build/
docs/_static/
docs/_templates/

# ============ ВРЕМЕННЫЕ ФАЙЛЫ ============
*.tmp
*.temp
.cache/

# ============ ЗАВИСИМОСТИ ================
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============ SSL/СЕРТИФИКАТЫ ============
*.pem
*.key
*.crt
*.csr
ssl/

# ============ МОДЕЛИ ML ==================
models/*.model
models/*.h5
models/*.pkl
models/*.joblib
!models/README.md

# ============ ФРОНТЕНД ===================
