packages/client/dist/
packages/client/.vite/
packages/client/.storybook/
packages/client/cypress/videos/
packages/client/cypress/screenshots/

# ============ БЭКЕНД =====================
packages/server/dist/
packages/server/.nyc_output
packages/server/coverage/

# ============ РАЗНОЕ =====================
*.seed
*.backup
dump.rdb
*.pid
*.pid.lock

# ============ ИСКЛЮЧЕНИЯ =================
!packages/client/public/
!packages/server/public/
!packages/shared/
!data/sample/
!docs/api/
!infrastructure/examples/

# ============ СИСТЕМНЫЕ ФАЙЛЫ ===========
system.log
error.log

# ============ КОНФИГУРАЦИЯ IDE ===========
.project
.classpath
.settings/
.factorypath

# ============ ВЕБ-ПАКЕТЫ =================
.webpack/
.webpack-cache/

# ============ PWA ========================
web-manifest.json
service-worker.js
sw.js

# ============ ЭКСПОРТЫ ===================
exported_data/
